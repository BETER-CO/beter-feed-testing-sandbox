{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case file",
  "description": "One case of the BETER Feed Testing Sandbox: a scripted sequence of feed content on the four channels, plus the transport faults the feed itself produces. A case file in the repository carries its caseId; the body without it is what POST /api/cases accepts.",
  "$ref": "#/$defs/caseBody",
  "required": ["caseId"],
  "unevaluatedProperties": false,
  "$defs": {
    "caseBody": {
      "type": "object",
      "required": ["version", "description", "class", "sport", "tags", "terminal", "script"],
      "properties": {
        "caseId": {
          "description": "The case id. It carries no meaning and is never reused. A case posted at runtime omits it or takes an id from 100000 up.",
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "description": "The case's own version, MAJOR.MINOR.PATCH.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "class": { "$ref": "#/$defs/caseClass" },
        "sport": {
          "description": "The sportId value of the feed.",
          "type": "integer"
        },
        "tags": {
          "description": "The tags that group cases for selection: smoke, resilience, settlement, content, the class slug, the sport name, any later grouping.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source": { "$ref": "#/$defs/source" },
        "contract": { "$ref": "#/$defs/contractPin" },
        "covers": {
          "description": "The public documentation page and section of each statement the case covers.",
          "type": "array",
          "items": { "$ref": "#/$defs/documentationSection" }
        },
        "script": {
          "description": "The ordered entries the sandbox plays: messages and fault directives.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scriptEntry" }
        },
        "expected": {
          "description": "The consumer behaviours a correct integration shows on this case. The sandbox never asserts them.",
          "type": "array",
          "items": { "$ref": "#/$defs/expectedEntry" }
        },
        "exposes": { "$ref": "#/$defs/exposes" },
        "terminal": { "$ref": "#/$defs/terminal" },
        "initialState": { "$ref": "#/$defs/initialState" },
        "start": { "$ref": "#/$defs/startMode" },
        "maxAcceleration": {
          "description": "The highest acceleration a run of this case accepts.",
          "type": "number",
          "minimum": 0.25,
          "maximum": 20,
          "default": 20
        },
        "duration": {
          "description": "The feed time the script spans, in seconds. Derived from the script.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "caseClass": {
      "description": "The class of the case: what the sandbox emits.",
      "type": "string",
      "enum": [
        "baseline",
        "lifecycle",
        "connect-state",
        "transport-faults",
        "offsets",
        "settlement",
        "trading-content",
        "incidents-scoreboard",
        "timetable-fields",
        "console-settings"
      ]
    },
    "terminal": {
      "description": "The state the case ends in; abandoned for the case that plays an abandoned match on purpose.",
      "type": "string",
      "enum": ["Finished", "Canceled", "abandoned"]
    },
    "startMode": {
      "description": "When the script clock of a run starts: when a connection presenting the run's apiKey value is bound, or at the run's creation.",
      "type": "string",
      "enum": ["onConnect", "now"],
      "default": "onConnect"
    },
    "channel": {
      "description": "A feed channel.",
      "type": "string",
      "enum": ["time_table", "trading", "scoreboard", "incident"]
    },
    "directive": {
      "description": "A transport fault the feed itself can produce.",
      "type": "string",
      "enum": ["connectionDrop", "heartbeatStop", "heartbeatResume"]
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/channel" },
      "uniqueItems": true
    },
    "contractPin": {
      "description": "The public feed documentation the case was curated against: the fetch date and the newest changelog entry on that date.",
      "type": "object",
      "required": ["fetchedAt", "newestChange"],
      "properties": {
        "fetchedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "newestChange": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "documentationSection": {
      "description": "A page of the public feed documentation and a section on it.",
      "type": "object",
      "required": ["page", "section"],
      "properties": {
        "page": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source": {
      "description": "Where the content comes from: a recording, authored steps, or both.",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["recorded", "authored", "mixed"] },
        "matchId": {
          "description": "The id of the recorded match.",
          "type": "string",
          "minLength": 1
        },
        "date": {
          "description": "The date of the recording.",
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "authoredSteps": {
          "description": "The authored steps, named.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["recorded", "mixed"] } }, "required": ["kind"] },
          "then": { "required": ["matchId", "date"] }
        },
        {
          "if": { "properties": { "kind": { "enum": ["authored", "mixed"] } }, "required": ["kind"] },
          "then": { "required": ["authoredSteps"] }
        }
      ]
    },
    "scriptEntry": {
      "oneOf": [
        { "$ref": "#/$defs/messageEntry" },
        { "$ref": "#/$defs/directiveEntry" }
      ]
    },
    "messageEntry": {
      "description": "A message the sandbox sends on one channel. Recorded ids, offsets and timestamps are rewritten at playback.",
      "type": "object",
      "required": ["at", "channel", "messageType", "value"],
      "properties": {
        "at": { "$ref": "#/$defs/at" },
        "channel": { "$ref": "#/$defs/channel" },
        "messageType": { "type": "string", "minLength": 1 },
        "value": {
          "description": "The content as the feed carries it. The case format names no sport, market or incident, so the value is not constrained here."
        }
      },
      "additionalProperties": false
    },
    "directiveEntry": {
      "description": "A fault directive. It fires at its at offset, or at after in place of at.",
      "type": "object",
      "required": ["directive", "channels"],
      "properties": {
        "at": { "$ref": "#/$defs/at" },
        "after": { "$ref": "#/$defs/after" },
        "directive": { "$ref": "#/$defs/directive" },
        "channels": { "$ref": "#/$defs/channels" }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["at"] },
        { "required": ["after"] }
      ]
    },
    "at": {
      "description": "The offset from the case start, in milliseconds of feed time.",
      "type": "integer",
      "minimum": 0
    },
    "after": {
      "description": "The event a directive waits for in place of an offset: the given batch of a connection's snapshot has been served.",
      "type": "object",
      "required": ["event", "batch"],
      "properties": {
        "event": { "type": "string", "const": "snapshotServed" },
        "batch": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "expectedEntry": {
      "type": "object",
      "required": ["id", "when", "behaviour", "cites", "basis"],
      "properties": {
        "id": {
          "description": "EX-<caseId>-<n>.",
          "type": "string",
          "pattern": "^EX-[0-9]+-[0-9]+$"
        },
        "when": {
          "description": "The script entry the behaviour follows: its zero-based position in script, the scriptIndex of the run output.",
          "type": "integer",
          "minimum": 0
        },
        "behaviour": {
          "description": "What a correct integration does, in the documentation's words.",
          "type": "string",
          "minLength": 1
        },
        "cites": {
          "type": "array",
          "items": { "$ref": "#/$defs/documentationSection" }
        },
        "basis": {
          "description": "documented where the documentation states the behaviour; recorded where the documentation is silent and the case plays what a recording shows.",
          "type": "string",
          "enum": ["documented", "recorded"]
        }
      },
      "additionalProperties": false
    },
    "exposes": {
      "description": "What the run output reports for this case: values for the figures that do not depend on the consumer, names only for the figures the output reports as observed.",
      "type": "object",
      "properties": {
        "terminal": { "$ref": "#/$defs/terminal" },
        "messages": {
          "description": "Messages per channel and message type, as one connection receives them.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/channel" },
          "additionalProperties": {
            "type": "object",
            "required": ["sent", "byMsgType"],
            "properties": {
              "sent": { "type": "integer", "minimum": 0 },
              "byMsgType": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 0 }
              }
            },
            "additionalProperties": false
          }
        },
        "offsets": {
          "description": "Offset ranges per channel, with the count of offsets sent again.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/channel" },
          "additionalProperties": {
            "type": "object",
            "required": ["first", "last", "resent"],
            "properties": {
              "first": { "type": "integer" },
              "last": { "type": "integer" },
              "resent": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "matches": {
          "description": "Per match of the case, in script order: the final state, markets by status and incidents by type.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finalState", "marketsByStatus", "incidentsByType"],
            "properties": {
              "finalState": { "type": "string" },
              "marketsByStatus": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 0 }
              },
              "incidentsByType": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 0 }
              }
            },
            "additionalProperties": false
          }
        },
        "directives": {
          "description": "The directive timeline: every directive of the script, in order.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scriptIndex", "directive", "channels"],
            "properties": {
              "scriptIndex": { "type": "integer", "minimum": 0 },
              "directive": { "$ref": "#/$defs/directive" },
              "channels": { "$ref": "#/$defs/channels" }
            },
            "additionalProperties": false
          }
        },
        "observed": {
          "description": "The connection-dependent figures, by name: the run output reports them as observed.",
          "type": "array",
          "items": { "type": "string", "enum": ["connections", "snapshots"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "initialState": {
      "description": "The case's state at offset 0, from which the ConnectionSnapshot of a connection arriving before the first script entry is built. No matches for a case that starts before booking.",
      "type": "object",
      "required": ["matches"],
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "description": "One match's state per channel, as recorded.",
            "type": "object",
            "properties": {
              "time_table": {},
              "trading": {},
              "scoreboard": {},
              "incident": {}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
